NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trocville
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d
# Identifiants OAuth (Web, iOS, Android), séparés par des virgules. Pas le secret.
GOOGLE_CLIENT_IDS=

# Envoi du code de confirmation. La clé et l'adresse d'expéditeur viennent de Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TrocVille
